<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catálogo de productos"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#172033" />

        <TextView
            android:id="@+id/tvPagina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Página 1 de 2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#172033" />

        <TextView
            android:id="@+id/tvCantidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sin productos cargados"
            android:textSize="14sp"
            android:textColor="#526071" />

        <Button
            android:id="@+id/btnCargar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cargar productos"
            android:textAllCaps="false" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/scrollProductos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/contenedorProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="#FFFFFF"
                    android:padding="24dp"
                    android:text="Laptop de prueba\n\nLaptop para estudiar y realizar trabajos.\n\nPrecio: $650.00\nCategoría: Tecnología\nRating: ★ 4.5\nStock: 12"
                    android:textColor="#172033"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="#FFFFFF"
                    android:padding="24dp"
                    android:text="Teclado de prueba\n\nTeclado compacto para uso diario.\n\nPrecio: $25.00\nCategoría: Accesorios\nRating: ★ 4.2\nStock: 30"
                    android:textColor="#172033"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="#FFFFFF"
                    android:padding="24dp"
                    android:text="Audífonos de prueba\n\nAudífonos para escuchar música.\n\nPrecio: $40.00\nCategoría: Audio\nRating: ★ 4.7\nStock: 18"
                    android:textColor="#172033"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="#FFFFFF"
                    android:padding="24dp"
                    android:text="Mochila de prueba\n\nMochila para transportar útiles.\n\nPrecio: $32.00\nCategoría: Accesorios\nRating: ★ 4.3\nStock: 20"
                    android:textColor="#172033"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="#FFFFFF"
                    android:padding="24dp"
                    android:text="Lámpara de prueba\n\nLámpara para un escritorio de estudio.\n\nPrecio: $18.00\nCategoría: Hogar\nRating: ★ 4.4\nStock: 15"
                    android:textColor="#172033"
                    android:textSize="16sp" />

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAnterior"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Anterior"
                android:textAllCaps="false"
                android:enabled="false" />

            <Button
                android:id="@+id/btnSiguiente"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Siguiente"
                android:textAllCaps="false"
                android:enabled="false" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>